# En-têtes de la page publique de suivi de course (le jeton de suivi est dans l'URL).
#
# La politique de contenu est en mode « rapport » : rien n'est bloqué, les violations apparaissent
# dans la console du navigateur. Après un test réel (carte, itinéraire, canal temps réel), remplacer
# « Content-Security-Policy-Report-Only » par « Content-Security-Policy » pour l'appliquer.
/track.html
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cache-Control: no-store
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.googleusercontent.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.googleapis.com; worker-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/track.js
  Cache-Control: no-cache

# Page de réinitialisation de mot de passe : le lien contient des jetons de récupération.
# Mêmes réserves que ci-dessus : politique de contenu en mode « rapport » jusqu'au test réel.
/reset-password.html
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cache-Control: no-store
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.supabase.co; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

/reset-password.js
  Cache-Control: no-cache

# Espaces privés de l'application (page unique servie par le fallback SPA) : jamais indexés.
# L'en-tête agit sans JavaScript ; la balise meta robots posée par src/utils/seo.ts le complète.
# Volontairement PAS de « Disallow » dans robots.txt : un robot qui ne peut pas explorer la page
# ne verrait pas ce « noindex » et pourrait quand même garder l'adresse dans ses résultats.
/dashboard
  X-Robots-Tag: noindex, nofollow
/client-dashboard
  X-Robots-Tag: noindex, nofollow
/admin
  X-Robots-Tag: noindex, nofollow
/admin-dashboard
  X-Robots-Tag: noindex, nofollow
/reset-password
  X-Robots-Tag: noindex, nofollow
/en/dashboard
  X-Robots-Tag: noindex, nofollow
/en/client-dashboard
  X-Robots-Tag: noindex, nofollow
/en/admin
  X-Robots-Tag: noindex, nofollow
/en/reset-password
  X-Robots-Tag: noindex, nofollow

# Liaison app Android (Digital Asset Links) : doit etre servi en JSON, sans redirection.
/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
